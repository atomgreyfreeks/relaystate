{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "replay-bundle.schema.json",
  "title": "Disaster replay bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario",
    "scenario_sha256",
    "source_data_sha256_by_id",
    "events",
    "final_state_by_arm",
    "replay_certificate",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": "disaster-replay.bundle.v1" },
    "scenario": { "$ref": "scenario.schema.json" },
    "scenario_sha256": { "$ref": "#/$defs/sha256" },
    "source_data_sha256_by_id": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/sha256" }
    },
    "events": { "type": "array", "minItems": 1, "items": { "$ref": "replay-event.schema.json" } },
    "final_state_by_arm": { "type": "object" },
    "replay_certificate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reducer_version", "event_count", "scenario_sha256", "source_data_sha256_by_id", "timeline_sha256", "terminal_event_sha256", "final_state_sha256_by_arm", "byte_identical_rebuild"],
      "properties": {
        "reducer_version": { "type": "string", "minLength": 1 },
        "event_count": { "type": "integer", "minimum": 1 },
        "scenario_sha256": { "$ref": "#/$defs/sha256" },
        "source_data_sha256_by_id": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        },
        "timeline_sha256": { "$ref": "#/$defs/sha256" },
        "terminal_event_sha256": { "$ref": "#/$defs/sha256" },
        "final_state_sha256_by_arm": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/sha256" }
        },
        "byte_identical_rebuild": { "type": "boolean" },
        "run_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "equality_keys", "runs"],
          "properties": {
            "schema_version": { "const": "disaster-replay.run-identity.v1" },
            "equality_keys": {
              "type": "object",
              "additionalProperties": false,
              "required": ["scenario_basis_sha256", "observation_set_sha256", "resources_sha256", "decision_slots_sha256"],
              "properties": {
                "scenario_basis_sha256": { "$ref": "#/$defs/sha256" },
                "observation_set_sha256": { "$ref": "#/$defs/sha256" },
                "resources_sha256": { "$ref": "#/$defs/sha256" },
                "decision_slots_sha256": { "$ref": "#/$defs/sha256" }
              }
            },
            "runs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["run_id", "arm"],
                "properties": {
                  "run_id": { "type": "string", "minLength": 1 },
                  "arm": { "enum": ["PLAIN_GRAPH", "EVIDENCE_GRAPH"] }
                }
              }
            }
          }
        }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
