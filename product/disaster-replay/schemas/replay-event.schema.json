{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "replay-event.schema.json",
  "title": "Disaster replay event",
  "description": "One immutable, source-classified event consumed by both the reducer and the 3D renderer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "sequence",
    "sim_time_s",
    "arm",
    "type",
    "actor",
    "entity_refs",
    "caused_by",
    "geometry",
    "temporal",
    "provenance",
    "graph",
    "payload",
    "previous_event_sha256",
    "event_sha256"
  ],
  "properties": {
    "schema_version": { "const": "disaster-replay.event.v1" },
    "event_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "sequence": { "type": "integer", "minimum": 0 },
    "sim_time_s": { "type": "integer", "minimum": 0 },
    "arm": { "enum": ["SHARED", "PLAIN_GRAPH", "EVIDENCE_GRAPH"] },
    "type": {
      "enum": [
        "WORLD_INITIALIZED",
        "SOURCE_INGESTED",
        "CLAIM_STATE_CHANGED",
        "GRAPH_TRANSITION",
        "DECISION_PROPOSED",
        "POLICY_EVALUATED",
        "RESOURCE_DISPATCHED",
        "OUTCOME_OBSERVED",
        "METRIC_UPDATED"
      ]
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "role"],
      "properties": {
        "kind": { "enum": ["WORLD", "SOURCE", "AGENT", "HUMAN", "POLICY", "REDUCER"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "role": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "entity_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "caused_by": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "geometry": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "coordinates": {}
          }
        }
      ]
    },
    "temporal": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["basis", "precision", "observed_at", "available_at"],
          "properties": {
            "basis": { "enum": ["SOURCE_FIELD_RECONSTRUCTED_FROM_SNAPSHOT", "OFFICIAL_REPORT_TIME"] },
            "precision": { "const": "MINUTE" },
            "observed_at": { "type": "string", "format": "date-time" },
            "available_at": { "type": "string", "format": "date-time" }
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "input_classifications", "source_ids", "explanation"],
      "properties": {
        "classification": {
          "enum": ["OBSERVED_PUBLIC", "SYNTHETIC_EXERCISE", "DERIVED_DETERMINISTIC", "RECORDED_MODEL_OUTPUT"]
        },
        "input_classifications": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["OBSERVED_PUBLIC", "SYNTHETIC_EXERCISE", "RECORDED_MODEL_OUTPUT"]
          },
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 2048 }
      }
    },
    "graph": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["graph_id", "node_id", "edge_id"],
          "properties": {
            "graph_id": { "type": "string", "minLength": 1 },
            "node_id": { "type": "string", "minLength": 1 },
            "edge_id": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "payload": { "type": "object" },
    "previous_event_sha256": { "$ref": "#/$defs/sha256" },
    "event_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
