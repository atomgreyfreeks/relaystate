{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scenario.schema.json",
  "title": "Disaster replay scenario",
  "description": "A frozen real-world incident basis plus an explicitly synthetic exercise overlay.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "title",
    "seed",
    "disclosure",
    "incident",
    "clock",
    "viewport",
    "data_sources",
    "world_features",
    "exercise",
    "agents",
    "resources",
    "graphs",
    "metrics",
    "reducer_version"
  ],
  "properties": {
    "schema_version": { "const": "disaster-replay.scenario.v1" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "disclosure": { "type": "string", "minLength": 1 },
    "incident": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "occurred_at", "latitude", "longitude", "depth_km", "magnitude", "maximum_intensity", "source_id"],
      "properties": {
        "kind": { "const": "EARTHQUAKE" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 },
        "depth_km": { "type": "number", "minimum": 0 },
        "magnitude": { "type": "number", "minimum": 0 },
        "maximum_intensity": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "start_at", "step_seconds"],
      "properties": {
        "basis": { "const": "SIMULATION_STEP" },
        "start_at": { "type": "string", "format": "date-time" },
        "step_seconds": { "type": "integer", "minimum": 1 }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "bounds"],
      "properties": {
        "center": { "$ref": "#/$defs/position" },
        "bounds": {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/position" }, { "$ref": "#/$defs/position" }],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "title", "classification", "provider", "url", "access", "attribution", "license_note"],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "classification": { "const": "OBSERVED_PUBLIC" },
          "provider": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "access": { "enum": ["BUNDLED_NORMALIZED", "REMOTE_TILE", "REMOTE_DOWNLOAD", "CATALOG_ONLY"] },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "archive_bytes": { "type": ["integer", "null"], "minimum": 0 },
          "attribution": { "type": "string", "minLength": 1 },
          "license_note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "world_features": { "type": "object" },
    "exercise": { "type": "object" },
    "agents": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "resources": { "type": "array", "minItems": 1, "items": { "type": "object" } },
    "decision_slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision_slot_id",
          "decision_type",
          "information_cutoff_sim_time_s",
          "visible_observation_ids",
          "eligible_resource_ids",
          "eligible_target_ids",
          "selection_count"
        ],
        "properties": {
          "decision_slot_id": { "type": "string", "minLength": 1 },
          "decision_type": { "const": "SCARCE_RESOURCE_ALLOCATION" },
          "information_cutoff_sim_time_s": { "type": "integer", "minimum": 0 },
          "visible_observation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "eligible_resource_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "eligible_target_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "selection_count": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "graphs": { "type": "array", "minItems": 2, "items": { "type": "object" } },
    "metrics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "unit", "direction", "formula", "scope"],
        "properties": {
          "metric_id": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["HIGHER_IS_BETTER", "LOWER_IS_BETTER"] },
          "formula": { "type": "string", "minLength": 1 },
          "scope": { "const": "SYNTHETIC_EXERCISE" }
        }
      }
    },
    "reducer_version": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    }
  }
}
